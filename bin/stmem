#!/usr/bin/env node
const path = require("path");

const SCRIPTS = path.resolve(__dirname, "..", "scripts");
const cmd = process.argv[2];

// --help / -h / 无参数 → 打印帮助
if (!cmd || cmd === "--help" || cmd === "-h") {
  console.log(`stmem — Stone Memory 多线程记忆系统

用法:
  stmem status                                  查看所有线程状态
  stmem ai-help                                输出给外部 Agent 的安全操作协议
  stmem capabilities [--json]                  声明内置导入、挖掘与重建能力
  stmem doctor --thread <id> [--json]           只读诊断配置、线程文件与运行状态
  stmem delete --thread <id> [--dry-run]        删除线程配置及数据
  stmem init --thread <真实线程ID>              交互式初始化
  stmem init --template [--runtime codex]       输出 AI 可填写的 JSON 模板
  stmem init --batch-file <json> --validate     严格校验配置和真实线程文件
  stmem init --batch-file <json>                使用与前端相同的正式接口初始化
  stmem fork --parent <id> --thread <id>        将线程登记为共享父级记忆的子线程
  stmem feature-phrases [--thread <id>]         从所有清洗后的 features 提取通用检索词
  stmem feature-evidence [--thread <id>]        回查 archive 与 feelings 的词频证据
  stmem compress [--thread <id>] [--before 日期]  dry-run 压缩 daily feelings
  stmem compress --thread <id> --apply          写入 coarse_summary 并切换为 coarse
  stmem compact [--thread <id>]                 对低风险高收益周生成压缩 dry-run
  stmem compact --thread <id> --apply           原子压缩排名第一周的 coarse 候选
  stmem compact --thread <id> --from 日期 --to 日期 --apply  原子压缩精确日期窗口
  stmem hidden [--thread <id>] [--after-days N]  预览非核心 coarse 的长期沉寂候选
  stmem hidden --thread <id> --apply             将候选原子切换为 hidden
  stmem lifecycle [--thread <id>] [--action 类型]  feeling 生命周期只读报告
  stmem term-timeline --thread <id> --terms <词列表>  archive 曲线与 feeling 小点
  stmem import --source <json|jsonl|sqlite>       预览导入映射（加 --apply 写入）
  stmem import --dir <path> [--thread <id>]       递归预览目录中的对话数据
  stmem mine [--thread <id>] --all                  挖掘全部未处理日期，生成feelings + features
  stmem mine [--thread <id>] [--date <YYYY-MM-DD>]  挖掘单日 feelings + features
  stmem mine [--thread <id>] --date <日期> --force   直接重挖并覆盖当天结果
  stmem mine --thread <id> --date <日期> --check --json  自检提示词、输入、上游响应与返回格式
  stmem mine --thread <id> --stop                  停止该记忆体当前挖掘任务
  stmem mine [--thread <id>] --targeted --batch-file <json>  对选中的对话精准补挖并追加摘要
  stmem mine --thread <id> --batch-file <json>    挖掘所选日期（单日直跑，多日自动批处理）
  stmem mine-review preview|list|mix|apply|discard            可审阅候选与按日替换
  stmem scratch inspect|settings|generate --thread <id>      刮刮乐奖励读取、设置与生成
  stmem dream --thread <id> --date <YYYY-MM-DD>     织梦：为已挖掘完成的日期生成一场梦
  stmem dream preferences --thread <id>            查看织梦策略与秘典状态
  stmem dream pin --thread <id> --type <type>      梦向牵引：指定下一场梦类型
  stmem dream unpin --thread <id>                  取消梦向牵引
  stmem dream guard --thread <id> on|off           安梦守护：随机排除噩梦与噩梦染春梦
  stmem dream multiplier --thread <id> --<type> <x> 梦谱调律：调整某类型倍率
  stmem dream prompt --thread <id> --type <key> [--set <file>|--reset]  织梦秘典：查看/保存/恢复 Prompt
  stmem rebuild --thread <id> [--window N] [--tool-pairs N]  预览重建
  stmem rebuild --thread <id> --queue           安全排队，下次主 MCP 启动时应用
  stmem rebuild --thread <id> --summary-limit N --min-importance N  临时筛选本次注入摘要
  stmem rebuild --thread <id> --apply           实际写入
  stmem rebuild --thread <id> --check           检查活动线程结构完整性
  stmem rebuild --thread <id> --repair          备份并修复可恢复的线程断链
  stmem rules list|import|update|delete|enable|disable --thread <id>  管理人设/规则
  stmem memory update|anchor --thread <id> --batch-file <json>  编辑摘要与锚点
  stmem watcher [status|on|off] --thread <id>   查看/修改该记忆体 watcher 期望状态
  stmem watcher set --thread <id> --archive|--miner|--compression|--dream on|off  修改内置插件
  stmem watcher set --thread <id> --dev-<name> on|off  修改开发者插件（必须 dev- 前缀）
  stmem notebook status|topic-create|topic-update|write|query|read|list --thread <id>
                                                管理主题 Markdown 笔记本
  stmem module list|inspect|paths|audit          查看模块、统一路径与执行模块契约审计
  stmem web [--port 4173]                       启动本地记忆管理前端
  stmem db [status|migrate|migrate-all|export] [--thread <id>]  数据库管理

所有 --thread 可省略，默认取第一个已配置线程。

配置: ~/.stone_memory/stmem.json`);
  process.exit(0);
}

switch (cmd) {
  case "ai-help":
    require(path.join(SCRIPTS, "stmem-ai-help"));
    break;
  case "capabilities":
    require(path.join(SCRIPTS, "stmem-capabilities"));
    break;
  case "doctor":
    require(path.join(SCRIPTS, "stmem-doctor"));
    break;
  case "init":
    require(path.join(SCRIPTS, "stmem-init"));
    break;
  case "fork":
    require(path.join(SCRIPTS, "stmem-fork"));
    break;
  case "feature-phrases":
    require(path.join(SCRIPTS, "stmem-feature-phrases"));
    break;
  case "feature-evidence":
    require(path.join(SCRIPTS, "stmem-feature-evidence"));
    break;
  case "compress":
    require(path.join(SCRIPTS, "stmem-compress"));
    break;
  case "compact":
    require(path.join(SCRIPTS, "stmem-compact"));
    break;
  case "hidden":
    require(path.join(SCRIPTS, "stmem-hidden"));
    break;
  case "lifecycle":
    require(path.join(SCRIPTS, "stmem-lifecycle"));
    break;
  case "term-timeline":
    require(path.join(SCRIPTS, "stmem-term-timeline"));
    break;
  case "mine":
    require(path.join(SCRIPTS, "stmem-mine"));
    break;
  case "mine-review":
    require(path.join(SCRIPTS, "stmem-mine-review"));
    break;
  case "scratch":
    Promise.resolve(require(path.join(SCRIPTS, "stmem-scratch")).runScratchCommand(process.argv.slice(3)))
      .catch(error => {
        console.error(`[scratch] error: ${error.message}`);
        process.exitCode = 1;
      });
    break;
  case "dream":
    try {
      require(path.join(SCRIPTS, "stmem-dream")).runDreamCommand(process.argv.slice(3));
    } catch (error) {
      console.error(error.message);
      process.exit(1);
    }
    break;
  case "notebook":
    try {
      require(path.join(SCRIPTS, "stmem-notebook")).runNotebookCommand(process.argv.slice(3));
    } catch (error) {
      console.error(error.message);
      process.exit(1);
    }
    break;
  case "module":
    Promise.resolve(require(path.join(SCRIPTS, "stmem-module")).runModuleCommand(process.argv.slice(3)))
      .catch(error => { console.error(`[module] error: ${error.message}`); process.exitCode = 1; });
    break;
  case "rebuild":
    require(path.join(SCRIPTS, "stmem-rebuild"));
    break;
  case "rules":
    require(path.join(SCRIPTS, "stmem-rules"));
    break;
  case "memory":
    require(path.join(SCRIPTS, "stmem-memory"));
    break;
  case "status":
    require(path.join(SCRIPTS, "stmem-status"));
    break;
  case "list":
    require(path.join(SCRIPTS, "stmem-list"));
    break;
  case "delete":
    require(path.join(SCRIPTS, "stmem-delete"));
    break;
  case "sync":
    require(path.join(SCRIPTS, "stmem-sync"));
    break;
  case "import":
    require(path.join(SCRIPTS, "stmem-import"));
    break;
  case "adapt":
    require(path.join(SCRIPTS, "stmem-adapt"));
    break;
  case "watcher":
    require(path.join(SCRIPTS, "stmem-watcher"));
    break;
  case "web":
    require(path.join(SCRIPTS, "stmem-web"));
    break;
  case "db":
    require(path.join(SCRIPTS, "stmem-db"));
    break;
  default:
    console.log("未知命令: " + cmd + "\n运行 stmem --help 查看可用命令");
    process.exit(1);
}
