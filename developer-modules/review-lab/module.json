{
  "id": "review-lab",
  "title": "记忆审阅室",
  "version": "1.0.0",
  "sdkVersion": 1,
  "scope": "memory",
  "permissions": ["core:read", "mining:review", "generation:use", "process:spawn"],
  "entry": { "frontend": "frontend/index.html", "commands": { "migrate": "migrations/migrate.js" } },
  "storage": { "files": ["candidates", "batches", "backups"], "browser": ["review-preferences"] },
  "migration": { "mode": "explicit", "receipt": "migration-receipt.json" }
  ,"coreExtensions": [
    { "path": "src/web/public/app.js", "reason": "主前端的审阅室兼容入口" },
    { "path": "src/web/public/developer-kit/runtime.js", "reason": "开发者前端运行时的审阅室兼容桥" },
    { "path": "src/web/server.js", "reason": "主服务的审阅室兼容 API" }
  ]
}
