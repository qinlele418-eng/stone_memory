{
  "id": "review-lab",
  "title": "记忆审阅室",
  "version": "1.0.0",
  "sdkVersion": 1,
  "scope": "memory",
  "permissions": ["core:read", "mining:review", "generation:use"],
  "entry": { "frontend": "index.html", "commands": { "review": "backend/commands/review.js" } },
