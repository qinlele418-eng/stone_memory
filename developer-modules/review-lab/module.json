{
  "id": "review-lab",
  "title": "记忆审阅室",
  "version": "1.0.0",
  "sdkVersion": 1,
  "scope": "memory",
  "permissions": ["core:read", "mining:review", "generation:use"],
  "entry": { "frontend": "frontend/index.html", "commands": { "migrate": "migrations/migrate.js" } },
  "storage": { "database": "module.sqlite", "files": ["candidates", "batches", "backups"], "browser": ["review-preferences"] },
  "migration": { "mode": "explicit", "receipt": "migration-receipt.json" }
}
