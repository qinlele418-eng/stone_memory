{
  "id": "extended-mining-workbench",
  "title": "拓展挖掘台",
  "version": "2.0.0",
  "sdkVersion": 1,
  "scope": "memory",
  "permissions": ["core:read", "mining:review"],
  "entry": { "frontend": "frontend/index.html", "commands": { "migrate": "migrations/migrate.js" } },
  "storage": { "database": "module.sqlite", "files": ["candidates", "batches"], "browser": ["profile", "rules"] },
  "migration": { "mode": "explicit", "receipt": "migration-receipt.json" }
}
