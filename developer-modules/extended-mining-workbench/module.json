{
  "id": "extended-mining-workbench",
  "title": "拓展挖掘台",
  "version": "2.0.0",
  "sdkVersion": 1,
  "scope": "memory",
  "permissions": ["core:read", "mining:review", "process:spawn"],
  "entry": { "frontend": "frontend/index.html", "commands": { "migrate": "migrations/migrate.js" } },
  "storage": { "files": ["candidates", "batches", "backups"], "browser": ["profile", "rules"] },
  "migration": { "mode": "explicit", "receipt": "migration-receipt.json" }
  ,"coreExtensions": [
    { "path": "src/web/server.js", "reason": "主服务的拓展挖掘兼容 API" }
  ]
}
