{
  "id": "extended-mining-workbench",
  "title": "拓展挖掘台",
  "version": "2.1.0",
  "sdkVersion": 1,
  "scope": "memory",
  "permissions": ["core:read", "mining:review"],
  "entry": { "frontend": "index.html", "commands": { "review": "backend/commands/review.js", "rules": "backend/commands/rules.js" } },
  "storage": { "database": "module.sqlite", "files": ["candidates", "batches", "rules.json"], "browser": ["profile", "rules"] },
  "legacy": {
    "frontend": "src/web/public/developer-modules/extended-mining-workbench",
    "commands": { "review": "scripts/stmem-mine-review.js" },
    "storage": [
      { "path": "<thread-dir>/memory/mining-candidates/", "mode": "候选摘要" },
      { "path": "<thread-dir>/memory/mining-batches/", "mode": "批处理状态" },
      { "path": "<thread-dir>/memory/backups/", "mode": "采用前备份" },
      { "path": "浏览器 localStorage", "mode": "模型与规则偏好" }
    ]
  }
}
