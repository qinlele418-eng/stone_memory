{
  "id": "notebook-lab",
  "title": "主题笔记",
  "version": "1.0.0",
  "sdkVersion": 1,
  "scope": "memory",
  "permissions": ["core:read", "generation:use"],
  "entry": { "frontend": "frontend/index.html", "commands": { "migrate": "migrations/migrate.js" } },
  "storage": { "database": "module.sqlite", "documents": "documents", "browser": ["paper-style"] },
  "migration": { "mode": "explicit", "receipt": "migration-receipt.json" }
  ,"coreExtensions": [
    { "path": "src/services/notebook-service.js", "reason": "现有主题笔记兼容服务" },
    { "path": "src/web/public/app.js", "reason": "主前端的主题笔记兼容入口" },
    { "path": "src/web/server.js", "reason": "主服务的主题笔记兼容 API" }
  ]
}
