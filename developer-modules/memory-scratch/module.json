{
  "id": "memory-scratch",
  "title": "刮刮乐",
  "contributor": "SM帝国左丞相可",
  "version": "1.0.0",
  "sdkVersion": 1,
  "scope": "memory",
  "permissions": ["core:read", "generation:use"],
  "entry": { "frontend": "frontend/index.html", "commands": { "migrate": "migrations/migrate.js" } },
  "storage": { "files": ["settings.json", "history.jsonl"], "browser": ["session-state"] },
  "migration": { "mode": "explicit", "receipt": "migration-receipt.json" }
  ,"coreExtensions": [
    { "path": "src/services/scratch-reward-service.js", "reason": "现有刮刮乐奖励兼容服务" },
    { "path": "src/web/server.js", "reason": "主服务的刮刮乐兼容 API" }
  ]
}
