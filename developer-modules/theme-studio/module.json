{
  "id": "theme-studio",
  "title": "前端工作台",
  "version": "1.0.0",
  "sdkVersion": 1,
  "scope": "global",
  "permissions": ["theme:write"],
  "entry": { "frontend": "index.html", "commands": {} },
  "storage": { "browser": ["theme", "custom-themes", "assets"] },
  "legacy": {
    "frontend": "src/web/public/theme-studio",
    "storage": [
      { "path": "浏览器 localStorage", "mode": "主题、素材和自定义主题" },
      { "path": "浏览器 sessionStorage", "mode": "跨模块主题快照" }
    ]
  }
}
