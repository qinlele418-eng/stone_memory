{
  "$schema": "https://stone-memory.local/schemas/ui-theme-v3.json",
  "version": 3,
  "coreTokenPrefix": "--stone-tide-",
  "defaults": {
    "name": "Stone Memory Original",
    "assets": {
      "logo": null
    },
    "tokens": {
      "colors": {
        "canvas": "#f5f8f1",
        "canvasWarm": "#fffef9",
        "ink": "#18372b",
        "inkSoft": "#69756d",
        "inkFaint": "#796d5d",
        "accent": "#397052",
        "accentStrong": "#295540",
        "accentSoft": "#eaf2e5",
        "surface": "rgba(255, 254, 249, 0.94)",
        "surfaceSoft": "#f2f3ef",
        "line": "#dce6d7",
        "lineSoft": "rgba(220, 230, 215, 0.90)",
        "status": "#7ea36f",
        "danger": "#a3463e",
        "warning": "#8a6542",
        "info": "#5f7196",
        "conflict": "#a65d56",
        "fusion": "#765a96"
      },
      "radii": {
        "extraSmall": "9px",
        "small": "12px",
        "medium": "18px",
        "large": "28px",
        "pill": "999px"
      },
      "shadows": {
        "card": "0 18px 50px rgba(41, 85, 64, 0.10)",
        "panel": "0 18px 50px rgba(41, 85, 64, 0.10)",
        "floating": "0 24px 70px rgba(41, 85, 64, 0.16)",
        "button": "0 10px 24px rgba(57, 112, 82, 0.24)"
      },
      "spacing": {
        "one": "6px",
        "two": "10px",
        "three": "14px",
        "four": "18px",
        "five": "24px",
        "six": "32px"
      },
      "typography": {
        "display": "Georgia, \"Noto Serif SC\", serif",
        "body": "Inter, \"Noto Sans SC\", \"Microsoft YaHei\", system-ui, sans-serif"
      },
      "motion": {
        "fast": "180ms",
        "normal": "200ms",
        "easing": "ease"
      }
    }
  },
  "editable": {
    "colors": ["canvas", "surface", "surfaceSoft", "ink", "inkSoft", "inkFaint", "accent", "accentStrong", "accentSoft", "line", "lineSoft", "status", "danger", "warning", "info", "conflict", "fusion"],
    "radii": ["small", "medium", "large"],
    "shadows": ["card", "panel"]
  }
}
